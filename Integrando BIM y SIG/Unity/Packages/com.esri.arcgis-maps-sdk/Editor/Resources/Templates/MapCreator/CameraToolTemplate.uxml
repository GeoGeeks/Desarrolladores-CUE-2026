<?xml version="1.0" encoding="utf-8"?>
<UXML
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="UnityEngine.UIElements"
	xmlns:editor="UnityEditor.UIElements"
	xmlns:esri="Esri.ArcGISMapsSDK.Editor.UI"
	xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
	xsi:schemaLocation="
						UnityEngine.UIElements ../../../../../../UIElementsSchema/UnityEngine.UIElements.xsd
						UnityEditor.UIElements ../../../../../../UIElementsSchema/UnityEditor.UIElements.xsd
						UnityEditor.PackageManager.UI ../../../../../../UIElementsSchema/UnityEditor.PackageManager.UI.xsd"
>
	<Style src="../../Styles/MapCreator/CameraToolStyle.uss" />
	<ScrollView>
		<VisualElement class="tool-holder">
			<Foldout class="main-foldout" text="Camera Location">
				<VisualElement class="unity-inspector-element">
					<VisualElement>
						<esri:ArcGISButtonField name="button-transfer-to-camera-field"/>
					</VisualElement>
					<editor:PropertyField label="Position" binding-path="position"/>
					<Foldout text="Rotation">
						<editor:PropertyField label="Heading" binding-path="rotation.Heading" name="cam-rotation-heading-text" />
						<editor:PropertyField label="Pitch" binding-path="rotation.Pitch" name="cam-rotation-pitch-text" />
						<editor:PropertyField label="Roll" binding-path="rotation.Roll" name="cam-rotation-roll-text" />
					</Foldout>
				</VisualElement>
			</Foldout>
		</VisualElement>
		<VisualElement class="create-button-holder">
			<Button class="button-create" name="button-create-camera" text="Create Camera"></Button>
		</VisualElement>
	</ScrollView>
</UXML>
