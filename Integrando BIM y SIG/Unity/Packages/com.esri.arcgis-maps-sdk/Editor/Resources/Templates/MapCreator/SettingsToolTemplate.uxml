<?xml version="1.0" encoding="utf-8"?>
<UXML
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="UnityEngine.UIElements"
	xmlns:editor="UnityEditor.UIElements"
	xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
	xsi:schemaLocation="
						UnityEngine.UIElements ../../../../../../UIElementsSchema/UnityEngine.UIElements.xsd
						UnityEditor.UIElements ../../../../../../UIElementsSchema/UnityEditor.UIElements.xsd
						UnityEditor.PackageManager.UI ../../../../../../UIElementsSchema/UnityEditor.PackageManager.UI.xsd"
>
	<ScrollView>
		<VisualElement class="tool-holder">
			<Foldout class="main-foldout" text="Editor Mode">
				<VisualElement class="unity-inspector-element">
					<editor:PropertyField binding-path="editorModeEnabled" label="Enable Editor Mode" />
					<editor:PropertyField binding-path="dataFetchWithSceneView" label="Data Fetch with Scene View" />
					<editor:PropertyField binding-path="rebaseWithSceneView" label="Rebase with Scene View" />
				</VisualElement>
			</Foldout>
			<Foldout class="main-foldout" text="Physics">
				<VisualElement class="unity-inspector-element">
					<editor:PropertyField binding-path="meshCollidersEnabled" label="Enable Mesh Colliders"/>
				</VisualElement>
			</Foldout>
		</VisualElement>
	</ScrollView>
</UXML>
